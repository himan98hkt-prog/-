# ─────────────────────────────────────────────────────────────
# 영상 생성 provider (하나 이상 필요)
# ─────────────────────────────────────────────────────────────
FAL_API_KEY=
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# ─────────────────────────────────────────────────────────────
# YouTube Data API v3 (OAuth 2.0 데스크톱 클라이언트)
#   client_secret.json 을 secrets/ 에 두고 경로만 지정
# ─────────────────────────────────────────────────────────────
YOUTUBE_CLIENT_SECRET_FILE=secrets/client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json

# ─────────────────────────────────────────────────────────────
# Instagram Graph API (프로페셔널 계정 + 연결된 페이스북 페이지 필요)
#   IG_USER_ID 는 인스타그램 비즈니스 계정 ID (숫자)
# ─────────────────────────────────────────────────────────────
IG_USER_ID=
IG_ACCESS_TOKEN=

# 인스타그램은 로컬 파일 업로드를 지원하지 않고 공개 URL 만 받는다.
# 아래 중 하나를 설정해 최종 mp4 를 공개 URL 로 노출시킬 것.
PUBLIC_MEDIA_BASE_URL=
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
