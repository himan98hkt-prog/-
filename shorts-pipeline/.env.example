# ─────────────────────────────────────────────────────────────
# 영상 생성 provider (하나 이상 필요)
# ─────────────────────────────────────────────────────────────
FAL_API_KEY=
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# ─────────────────────────────────────────────────────────────
# YouTube Data API v3 (OAuth 2.0 데스크톱 클라이언트)
#   client_secret.json 을 secrets/ 에 두고 경로만 지정
# ─────────────────────────────────────────────────────────────
YOUTUBE_CLIENT_SECRET_FILE=secrets/client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json

# ─────────────────────────────────────────────────────────────
# Instagram Graph API (프로페셔널 계정 + 연결된 페이스북 페이지 필요)
#   IG_USER_ID 는 인스타그램 비즈니스 계정 ID (숫자)
# ─────────────────────────────────────────────────────────────
IG_USER_ID=
IG_ACCESS_TOKEN=

# ─────────────────────────────────────────────────────────────
# 스토리지 — 기본값은 Cloudflare R2 무료 티어 기준
#   인스타그램은 로컬 파일을 못 받고 공개 URL 만 받는다.
#   R2 무료 티어: 보관 10GB · 쓰기 1M/월 · 읽기 10M/월 · 이그레스 무료 (월 갱신)
#
#   R2 대시보드 → R2 → Manage API Tokens 에서
#   "Object Read & Write" 토큰을 만들면 아래 3개를 한 번에 준다.
# ─────────────────────────────────────────────────────────────
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# R2 는 비워두면 auto 로 잡힌다. AWS S3 를 쓸 때만 실제 리전을 넣는다.
#   AWS S3        : S3_ENDPOINT_URL 을 비우고 S3_REGION=ap-northeast-2
#   Backblaze B2  : https://s3.<region>.backblazeb2.com
#   MinIO         : http://localhost:9000
S3_REGION=

# R2 커스텀 도메인 / CloudFront. url_strategy: public 일 때만 필요
S3_PUBLIC_BASE_URL=

# 스토리지를 안 쓰고 직접 정적 호스팅할 때의 베이스 URL (대체 경로)
PUBLIC_MEDIA_BASE_URL=

# ─────────────────────────────────────────────────────────────
# 제목 자동 작성 (선택 — 없어도 규칙으로 제목이 나온다)
#   openrouter.ai → Keys. 카드 등록 없이 무료 모델을 하루 50회까지 쓴다.
#   OPENROUTER_MODEL 은 비워두는 편이 좋다 — 무료 모델은 수시로 없어지므로
#   그때그때 살아 있는 것 중에서 자동으로 고른다.
# ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# fal.ai 에 충전해 둔 금액($). 남은 금액을 화면에 보여주는 데만 쓴다.
FAL_TOPUP_USD=
