# ─────────────────────────────────────────────────────────────
# 영상 생성 provider (하나 이상 필요)
# ─────────────────────────────────────────────────────────────
FAL_API_KEY=
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# ─────────────────────────────────────────────────────────────
# YouTube Data API v3 (OAuth 2.0 데스크톱 클라이언트)
#   client_secret.json 을 secrets/ 에 두고 경로만 지정
# ─────────────────────────────────────────────────────────────
YOUTUBE_CLIENT_SECRET_FILE=secrets/client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json

# ─────────────────────────────────────────────────────────────
# Instagram Graph API (프로페셔널 계정 + 연결된 페이스북 페이지 필요)
#   IG_USER_ID 는 인스타그램 비즈니스 계정 ID (숫자)
# ─────────────────────────────────────────────────────────────
IG_USER_ID=
IG_ACCESS_TOKEN=

# ─────────────────────────────────────────────────────────────
# S3 호환 스토리지
#   인스타그램은 로컬 파일을 못 받고 공개 URL 만 받는다.
#   기본 전략(presigned)은 버킷을 공개로 열 필요가 없다.
# ─────────────────────────────────────────────────────────────
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS S3 가 아니면 엔드포인트를 지정한다
#   Cloudflare R2 : https://<account_id>.r2.cloudflarestorage.com  (S3_REGION=auto)
#   Backblaze B2  : https://s3.<region>.backblazeb2.com
#   MinIO         : http://localhost:9000
S3_ENDPOINT_URL=

# CloudFront / R2 커스텀 도메인. url_strategy: public 일 때만 필요
S3_PUBLIC_BASE_URL=

# 스토리지를 안 쓰고 직접 정적 호스팅할 때의 베이스 URL (구방식 대체 경로)
PUBLIC_MEDIA_BASE_URL=
