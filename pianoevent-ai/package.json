{
  "name": "pianoevent-ai",
  "version": "0.1.0",
  "private": true,
  "description": "피아노학원 연주회 준비 프로그램",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "shots": "node scripts/shots.mjs",
    "demo": "next build && next start",
    "reset": "node -e \"require('node:fs').rmSync('.data',{recursive:true,force:true});console.log('데모 데이터를 처음 상태로 되돌렸습니다.')\"",
    "promo": "node scripts/promo-shots.mjs",
    "verify:detail": "node scripts/verify-detail.mjs",
    "verify:stage": "node scripts/verify-stage.mjs",
    "verify:video": "node scripts/verify-video.mjs",
    "mobile": "node scripts/mobile.mjs",
    "pack": "node scripts/pack.mjs",
    "demo:build": "vite build --config demo/vite.config.ts && node scripts/build-artifact.mjs",
    "demo:verify": "node scripts/verify-demo.mjs",
    "carousel": "python3 scripts/build-carousel.py && node scripts/carousel-shot.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:easy": "node scripts/verify-easy.mjs",
    "manual:shots": "node scripts/manual-shots.mjs",
    "sample:xlsx": "node scripts/sample-xlsx.mjs",
    "verify:simple": "node scripts/verify-simple.mjs",
    "desktop": "npm run build && node scripts/build-desktop.mjs",
    "desktop:dev": "node scripts/build-desktop.mjs && electron .",
    "dist": "npm run desktop && electron-builder --linux",
    "dist:win": "npm run desktop && electron-builder --win",
    "dist:mac": "npm run desktop && electron-builder --mac",
    "verify:poster": "node scripts/verify-poster.mjs",
    "verify:poster:all": "node scripts/verify-poster.mjs --all",
    "shots:splash": "node scripts/splash-shot.mjs",
    "key:new": "node --experimental-strip-types scripts/make-keys.ts",
    "verify:mobile": "node scripts/verify-mobile.mjs",
    "pack:web": "node scripts/pack-web.mjs",
    "verify:web": "node scripts/verify-web.mjs",
    "keygen:build": "node scripts/make-keygen.mjs",
    "secret:check": "node --experimental-strip-types scripts/check-license-secret.mjs",
    "product:image": "node scripts/make-product-image.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@supabase/supabase-js": "^2.112.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "jsqr": "^1.4.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "qrcode-terminal": "^0.12.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  },
  "main": "desktop/main.js",
  "author": {
    "name": "아첼쌤"
  },
  "repository": "https://github.com/himan98hkt-prog/-",
  "desktopName": "pianoevent.desktop"
}
