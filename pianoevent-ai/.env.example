# ─────────────────────────────────────────────────────────────
# PianoEvent AI 환경변수
# 아무것도 설정하지 않아도 앱은 데모 저장소 + 내장 규칙 엔진으로 완전히 동작합니다.
# ─────────────────────────────────────────────────────────────

# AI (Google AI Studio) — 서버에서만 사용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
GEMINI_API_KEY=
# 모델은 수명이 있으므로 교체 가능하게 둡니다 (기본: gemini-2.5-pro / gemini-2.5-flash)
GEMINI_MODEL_PRO=
GEMINI_MODEL_FLASH=
GEMINI_TIMEOUT_MS=45000

# Supabase — 세 값이 모두 없으면 로컬 데모 저장소(.data/store.json)를 씁니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. RLS 를 우회하므로 절대 클라이언트에 노출하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# 카카오톡 공유 (선택). 없으면 링크 복사 / 기기 공유 시트로 동작합니다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# 개인정보처리방침 페이지에 표기되는 사업자 정보
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PRIVACY_EFFECTIVE_DATE=2026-01-01
