{
  "name": "academy-note",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "학원 관리노트 - 전 계열 학원/공부방용 PWA (Lite: IndexedDB / Pro: Supabase)",
  "scripts": {
    "dev": "vite",
    "start": "vite --open /lite.html",
    "build": "vite build",
    "preview": "vite preview --port 4173",
