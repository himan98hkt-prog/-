    "check": "npm test && npm run build",
    "test:watch": "vitest",
    "perf": "node scripts/perf.mjs",
    "smoke": "node scripts/smoke.mjs",
    "demo": "node scripts/singlefile.mjs",
    "shots": "node scripts/shots.mjs",
