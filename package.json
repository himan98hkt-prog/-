  "dependencies": {
    "dexie": "^4.0.10",
    "@supabase/supabase-js": "^2.47.10"
  },
  "devDependencies": {
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "fake-indexeddb": "^6.0.0",
    "playwright": "^1.49.1"
  },
  "engines": {
    "node": ">=20"
  }
