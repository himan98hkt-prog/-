# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# 모델 문자열은 여기서만 관리한다(CLAUDE.md 절대규칙 12). 코드 하드코딩 금지.
COMPOSER_MODEL=claude-opus-5
WRITER_MODEL=claude-sonnet-5
# 곡 1개 생성에 허용하는 최대 API 비용(USD). 초과 시 파이프라인 중단.
MAX_COST_PER_COMPOSITION=2.50
# 시작 시 모델 문자열 유효성 검사 방식: strict | warn | off
MODEL_VALIDATION=warn

# ── 인프라 ───────────────────────────────────────────────────────────────────
POSTGRES_USER=concours
POSTGRES_PASSWORD=concours
POSTGRES_DB=concours
DATABASE_URL=postgresql+psycopg://concours:concours@localhost:5432/concours
REDIS_URL=redis://localhost:6379/0
DATA_DIR=./data
API_PORT=8000
WEB_PORT=3000
DB_PORT=5432
REDIS_PORT=6379

# ── 외부 도구 경로(비우면 PATH에서 탐색) ─────────────────────────────────────
MSCORE_BIN=mscore
AUDIVERIS_BIN=audiveris
FFMPEG_BIN=ffmpeg
FLUIDSYNTH_BIN=fluidsynth
SOUNDFONT_PATH=/assets/soundfont/FluidR3_GM.sf2

# ── 채보 ─────────────────────────────────────────────────────────────────────
TRANSCRIPTION_MODEL_DIR=./models
TRANSCRIPTION_DEVICE=auto      # auto | cpu | cuda
TRANSCRIPTION_MAX_MINUTES=10

# ── 개인정보 ─────────────────────────────────────────────────────────────────
# 학생 원본 영상 보존 기간(일). 0이면 무기한.
MEDIA_RETENTION_DAYS=180
