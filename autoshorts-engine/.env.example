# ── 하이라이트 분석 (선택) ──────────────────────────────────────
# Gemini 무료 티어 키 (https://aistudio.google.com/apikey 에서 발급)
# 비워 두면 오프라인 휴리스틱 분석으로 자동 대체됩니다 — 완전 무과금 동작.
GEMINI_API_KEY=

# 기본 모델. 무료 티어에서 가장 넉넉한 Flash 계열을 권장합니다.
GEMINI_MODEL=gemini-2.0-flash

# ── 급상승 탐색 (autoshorts trend 를 쓸 때만 필요) ───────────────
# https://console.cloud.google.com 에서 YouTube Data API v3 를 켜고 발급.
# 2026-06-01 granular quota 기준: search.list 와 videos.insert 는 각각 전용 버킷
# (호출당 1 유닛, 기본 하루 100회)이고, 나머지 메서드가 공용 10,000 유닛을 씁니다.
# 채널 모드는 공용 버킷만 써서 1회 1~4 유닛으로 끝납니다.
#
# 프로젝트가 증액을 받았거나 정책이 또 바뀌면 아래로 덮어쓰세요(비우면 기본값).
# AUTOSHORTS_YT_UPLOAD_DAILY_CALLS=100
# AUTOSHORTS_YT_SEARCH_DAILY_CALLS=100
# AUTOSHORTS_YT_QUERIES_DAILY_UNITS=10000
YOUTUBE_API_KEY=

# ── FFmpeg (PATH 에 없을 때만) ─────────────────────────────────
# AUTOSHORTS_FFMPEG=/usr/local/bin/ffmpeg
# AUTOSHORTS_FFPROBE=/usr/local/bin/ffprobe
