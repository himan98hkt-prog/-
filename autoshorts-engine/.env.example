# ── 하이라이트 분석 (선택) ──────────────────────────────────────
# Gemini 무료 티어 키 (https://aistudio.google.com/apikey 에서 발급)
# 비워 두면 오프라인 휴리스틱 분석으로 자동 대체됩니다 — 완전 무과금 동작.
GEMINI_API_KEY=

# 기본 모델. 무료 티어에서 가장 넉넉한 Flash 계열을 권장합니다.
GEMINI_MODEL=gemini-2.0-flash

# ── 급상승 탐색 (autoshorts trend 를 쓸 때만 필요) ───────────────
# https://console.cloud.google.com 에서 YouTube Data API v3 를 켜고 발급.
# 무료 할당량은 하루 10,000 유닛이며, 키워드 검색은 1회 100 유닛,
# 채널 모드는 1회 1~4 유닛입니다.
YOUTUBE_API_KEY=

# ── FFmpeg (PATH 에 없을 때만) ─────────────────────────────────
# AUTOSHORTS_FFMPEG=/usr/local/bin/ffmpeg
# AUTOSHORTS_FFPROBE=/usr/local/bin/ffprobe

# ── Phase 2 (SaaS) ─────────────────────────────────────────
# PostgreSQL 연결 문자열. 비밀번호가 들어가므로 이 파일에 실제 값을 쓰지 말 것.
AUTOSHORTS_DATABASE_URL=postgresql://autoshorts@127.0.0.1:5432/autoshorts
# presigned 업로드 서명 키. 운영에서는 반드시 고정값을 주입한다
# (없으면 프로세스마다 임시 키가 생겨 재시작 시 발급된 티켓이 모두 무효가 된다).
AUTOSHORTS_UPLOAD_SECRET=
# 로컬 오브젝트 스토리지·작업 디렉터리 루트
AUTOSHORTS_STORAGE_ROOT=var/storage
AUTOSHORTS_WORK_ROOT=var/work
AUTOSHORTS_OUTPUT_ROOT=var/output
# 워커
AUTOSHORTS_QUEUE=default
AUTOSHORTS_WORKER_ID=
# 테스트용 DB (없으면 SaaS 테스트는 자동으로 건너뛴다)
AUTOSHORTS_TEST_DATABASE_URL=
