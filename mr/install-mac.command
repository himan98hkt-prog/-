#!/bin/bash
# ===========================================================================
#  피아노 학원 반주 프로그램 — 맥·리눅스 설치·실행
#
#  두 번 눌러 실행하세요. 처음엔 설치까지 하고, 그 다음부터는 바로 뜹니다.
#
#  맥에서 「확인되지 않은 개발자」라고 막히면, 이 파일을 **오른쪽 버튼으로
#  누르고 → 열기** 를 고르시면 됩니다. 한 번만 하면 그 다음부터는 그냥 열립니다.
# ===========================================================================
cd "$(dirname "$0")" || exit 1

export PYTHONIOENCODING=utf-8

# python3 를 찾습니다. 맥에 기본으로 깔린 것이 너무 낮을 수 있어
# 버전 확인은 setup.py 가 다시 합니다.
PY=""
for c in python3.13 python3.12 python3.11 python3; do
  if command -v "$c" >/dev/null 2>&1; then PY="$c"; break; fi
done

if [ -z "$PY" ]; then
  cat <<'EOF'

  ============================================================
   파이썬이 필요합니다. 아직 안 깔려 있습니다.
  ============================================================

   · https://www.python.org/downloads/  에서 내려받아 설치하거나
   · Homebrew 가 있으시면:   brew install python

   설치가 끝나면 이 파일을 다시 두 번 누르세요.

EOF
  read -r -p "  엔터를 누르면 창이 닫힙니다. " _
  exit 1
fi

"$PY" tools/setup.py
code=$?
if [ $code -ne 0 ]; then
  read -r -p "  엔터를 누르면 창이 닫힙니다. " _
fi
exit $code
