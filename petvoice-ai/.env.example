# 클라이언트에 들어가도 안전한 값만 둔다.
# ⚠️ GEMINI_API_KEY 는 절대 여기에 두지 말 것 (Play Console 보안 스캔 거절 사유).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 아래 두 값은 Supabase 서버(Edge Function) 시크릿으로만 설정한다.
#   supabase secrets set GEMINI_API_KEY=...
#   (SUPABASE_SERVICE_ROLE_KEY 는 Supabase 가 자동 주입)
