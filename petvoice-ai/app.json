{
  "expo": {
    "name": "PetVoice AI",
    "slug": "petvoice-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "petvoice",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF9F4"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.petvoice.ai",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "반려동물의 울음소리를 녹음해 감정을 분석하는 데만 사용합니다.",
        "NSCameraUsageDescription": "반려동물의 자세와 표정을 촬영해 행동을 분석하는 데만 사용합니다.",
        "NSPhotoLibraryUsageDescription": "저장된 반려동물 사진으로 분석하거나 포토카드를 만들기 위해 사용합니다.",
        "NSPhotoLibraryAddUsageDescription": "만든 포토카드를 사진 앱에 저장하기 위해 사용합니다.",
        "UIApplicationShortcutItems": [
          {
            "UIApplicationShortcutItemType": "app.petvoice.ai.record",
            "UIApplicationShortcutItemTitle": "SHORTCUT_RECORD_TITLE",
            "UIApplicationShortcutItemSubtitle": "SHORTCUT_RECORD_SUBTITLE",
            "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypeAudio",
            "UIApplicationShortcutItemUserInfo": {
              "url": "petvoice://record"
            }
          },
          {
            "UIApplicationShortcutItemType": "app.petvoice.ai.precise",
            "UIApplicationShortcutItemTitle": "SHORTCUT_PRECISE_TITLE",
            "UIApplicationShortcutItemSubtitle": "SHORTCUT_PRECISE_SUBTITLE",
            "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypeTaskCompleted",
            "UIApplicationShortcutItemUserInfo": {
              "url": "petvoice://precise"
            }
          }
        ]
      }
    },
    "android": {
      "package": "app.petvoice.ai",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF9F4"
      },
      "permissions": ["RECORD_AUDIO", "CAMERA", "READ_MEDIA_IMAGES", "com.android.vending.BILLING"],
      "blockedPermissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "반려동물의 자세와 표정을 촬영해 행동을 분석하는 데만 사용합니다.",
          "microphonePermission": "반려동물의 울음소리를 녹음해 감정을 분석하는 데만 사용합니다.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "저장된 반려동물 사진으로 분석하거나 포토카드를 만들기 위해 사용합니다."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "반려동물의 울음소리를 녹음해 감정을 분석하는 데만 사용합니다."
        }
      ],
      "./plugins/withRecordShortcut"
    ],
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    },
    "locales": {
      "ko": "./locales/ko.json",
      "en": "./locales/en.json",
      "ja": "./locales/ja.json"
    }
  }
}
