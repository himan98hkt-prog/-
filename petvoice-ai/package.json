{
  "name": "petvoice-ai",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "description": "PetVoice AI - 반려동물 울음소리 & 행동 심리 멀티모달 분석기 (Expo)",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "eval": "vite-node eval/run.ts --",
    "eval:controls": "node eval/make-controls.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval:photos": "vite-node eval/photos.ts --"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@supabase/supabase-js": "^2.45.4",
    "expo": "~51.0.39",
    "expo-av": "~14.0.7",
    "expo-camera": "~15.0.16",
    "expo-constants": "~16.0.2",
    "expo-file-system": "~17.0.1",
    "expo-image-manipulator": "~12.0.5",
    "expo-image-picker": "~15.0.7",
    "expo-localization": "~15.0.3",
    "expo-notifications": "^0.28.19",
    "expo-secure-store": "~13.0.2",
    "expo-sharing": "~12.0.1",
    "expo-sqlite": "~14.0.6",
    "expo-status-bar": "~1.12.1",
    "expo-system-ui": "~3.0.7",
    "jpeg-js": "^0.4.4",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-iap": "12.16.4",
    "react-native-view-shot": "3.8.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "~18.2.79",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.9.6",
    "typescript": "~5.3.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^2.1.8"
  }
}
