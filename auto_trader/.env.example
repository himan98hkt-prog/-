# ------------------------------------------------------------------
# 이 파일을 .env 로 복사해 값을 채우세요.  cp .env.example .env
# 주의: 값 뒤에 주석을 달지 마세요. `KEY=   # 설명` 은 python-dotenv 가
#       주석 전체를 값으로 읽습니다. 설명은 반드시 윗줄에 둡니다.
# ------------------------------------------------------------------

# --- 실행 환경 ---
# VTS(모의) | REAL(실전)
KIS_ENV=VTS
# true 면 주문을 전송하지 않고 로그·알림만 남김
DRY_RUN=true
LOG_LEVEL=INFO

# --- 한국투자증권 ---
KIS_APP_KEY=
KIS_APP_SECRET=
# 계좌번호 앞 8자리
KIS_ACCOUNT_NO=
# 계좌 상품코드 (뒤 2자리)
KIS_ACCOUNT_PRODUCT_CD=01

# --- AI ---
ANTHROPIC_API_KEY=
# 개발 시점 최신 Sonnet급 모델 ID
CLAUDE_MODEL=claude-sonnet-5
# 비워 둘 것. Sonnet 5·Opus 5 등 최신 모델은 temperature 를 거부(400)합니다.
# 구형 모델을 쓸 때만 0.2 처럼 지정하세요.
CLAUDE_TEMPERATURE=
# 비워 두면 API 기본값(high). low | medium | high | xhigh | max
# AI 호출 비용을 줄이려면 low 또는 medium 을 권장합니다.
CLAUDE_EFFORT=
GEMINI_API_KEY=
# 개발 시점 최신 Pro/Flash급 모델 ID
GEMINI_MODEL=gemini-3.1-pro-preview
# Gemini 는 temperature 를 지원합니다 (기본 0.2)
GEMINI_TEMPERATURE=0.2

# ChatGPT (선택) — 비워두면 Claude·Gemini 둘로만 판단합니다.
# 넣으면 세 AI 만장일치일 때만 매수합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
# 비워 둘 것. 최신 추론 모델은 temperature 를 거부합니다.
OPENAI_TEMPERATURE=


# --- 알림 ---
# telegram | discord
NOTIFIER=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
