# --- 실행 환경 ---
KIS_ENV=VTS                # VTS(모의) | REAL(실전)
DRY_RUN=true               # true면 주문 미전송
LOG_LEVEL=INFO

# --- 한국투자증권 ---
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=            # 계좌번호 앞 8자리
KIS_ACCOUNT_PRODUCT_CD=01  # 계좌 상품코드 (뒤 2자리)

# --- AI ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5     # 개발 시점 최신 Sonnet급 모델 ID
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro      # 개발 시점 최신 Pro/Flash급 모델 ID

# --- 뉴스 (선택) ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 알림 ---
NOTIFIER=telegram          # telegram | discord
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
