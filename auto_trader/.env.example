# ------------------------------------------------------------------
# 이 파일을 .env 로 복사해 값을 채우세요.  cp .env.example .env
# 주의: 값 뒤에 주석을 달지 마세요. `KEY=   # 설명` 은 python-dotenv 가
#       주석 전체를 값으로 읽습니다. 설명은 반드시 윗줄에 둡니다.
# ------------------------------------------------------------------

# --- 실행 환경 ---
# VTS(모의) | REAL(실전)
KIS_ENV=VTS
# true 면 주문을 전송하지 않고 로그·알림만 남김
DRY_RUN=true
LOG_LEVEL=INFO

# --- 한국투자증권 ---
KIS_APP_KEY=
KIS_APP_SECRET=
# 계좌번호 앞 8자리
KIS_ACCOUNT_NO=
# 계좌 상품코드 (뒤 2자리)
KIS_ACCOUNT_PRODUCT_CD=01

# --- AI ---
# 어느 엔진이 판단에 참여하는지는 config/settings.yaml 의 ai.engines 가 정합니다.
# 기본값은 ["claude"] 입니다 — 명단에 없는 엔진의 키는 비워 두어도 기동됩니다.
#
# [비용] Claude Max / Ultra / Team 구독에는 월 API 크레딧이 포함됩니다
#        (Max $100 / Ultra $200). claude.ai → 설정 → 청구 → API credits 에서
#        Console 조직을 연결하고, **그 조직에서 발급한 키**를 아래에 넣으면
#        구독에 포함된 크레딧으로 차감됩니다. Console 에 카드 등록은 필요 없고,
#        크레딧이 소진되면 요청이 멈출 뿐 구독료에 추가 청구되지 않습니다.
#        주의: 플랜 1개 ↔ Console 조직 1개로 고정되며 본인 변경이 불가합니다.
ANTHROPIC_API_KEY=
# Opus 5.5 — 실측 기준 15분 주기로 월 $41 수준이라 $100 크레딧 안에 들어옵니다.
# 더 줄이려면 claude-sonnet-5-5, 최소로 줄이려면 claude-haiku-5-5.
CLAUDE_MODEL=claude-opus-5-5
# 비워 둘 것. Sonnet 5·Opus 5 등 최신 모델은 temperature 를 거부(400)합니다.
# 구형 모델을 쓸 때만 0.2 처럼 지정하세요.
CLAUDE_TEMPERATURE=
# 비워 두면 API 기본값(high). low | medium | high | xhigh | max
# AI 호출 비용을 줄이려면 low 또는 medium 을 권장합니다.
CLAUDE_EFFORT=
# --- Gemini (기본 구성에서는 미사용) ---
# ai.engines 에 "gemini" 를 넣을 때만 필요합니다. 기본 명단에 없으므로 비워 두세요.
# 무료 등급의 일일 한도는 모델마다 다르고 Google 이 중앙 표를 공개하지 않습니다 —
# 쓰실 거라면 AI Studio 의 본인 프로젝트 한도 페이지에서 직접 확인하세요.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Gemini 는 temperature 를 지원합니다 (기본 0.2)
GEMINI_TEMPERATURE=0.2

# --- ChatGPT (기본 구성에서는 미사용) ---
# ai.engines 에 "chatgpt" 를 넣을 때만 필요합니다.
# OpenAI 는 무료 등급이 없어 넣는 순간 별도 요금이 발생합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
# 비워 둘 것. 최신 추론 모델은 temperature 를 거부합니다.
OPENAI_TEMPERATURE=


# --- 알림 ---
# telegram | discord
NOTIFIER=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
